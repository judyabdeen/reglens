# RegLens configuration.
# Copy this file to ".env" (same folder) and fill in your key. ".env" is git-ignored: NEVER commit it,
# paste it into chats, or take screenshots that show it.

# --- Language model provider -------------------------------------------------
# One of: gemini | openai | anthropic   (default: gemini)
LLM_PROVIDER=gemini

# Google Gemini. Free key: https://aistudio.google.com/apikey
# Note: on the free tier Google may use your prompts to improve its products,
# so never type confidential information into RegLens.
GEMINI_API_KEY=

# Models listed as "free of charge" on Google's pricing page (checked 2026-11-11).
# Model names change over time: `python scripts/check_setup.py` lists the ones your key can use.
GEMINI_MODEL=gemini-3.5-flash
# Free-tier limits are per model, so a second model gives the app a fallback when the first is busy.
# Several fallbacks can be listed, separated by commas; they are tried in that order.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Gemini 3 models think before they answer. "low" keeps answers fast and leaves the output budget for the answer.
# One of: minimal | low | medium | high | default (default sends no thinking setting at all).
GEMINI_THINKING_LEVEL=low

# --- Optional alternative providers (leave empty if unused) ------------------
# OpenAI has no default model (names change too often): set OPENAI_MODEL when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Retrieval (the defaults are right for the project; change them only to run an experiment) -------------
# Local models, downloaded once from huggingface.co. No document text leaves your computer.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Vector store: chroma (ChromaDB) or numpy (exact search over a matrix; the evaluation compares the two).
VECTORSTORE=chroma
# Where the index lives. Leave empty: it is data/index, or - if the project sits inside OneDrive, Dropbox or
# similar - a folder under %LOCALAPPDATA%\RegLens, because sync clients lock database files.
VECTORSTORE_DIR=
# The chunks that scripts/build_index.py reads (the output of scripts/ingest.py).
CHUNKS_PATH=
